<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.xcx.mapper.XcxHistorySearchMapper">

    <resultMap type="XcxHistorySearch" id="XcxHistorySearchResult">
        <result property="id"    column="id"    />
        <result property="phone"    column="phone"    />
        <result property="keyword"    column="keyword"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectXcxHistorySearchVo">
        select id, phone, keyword, create_time, update_time, remark from xcx_history_search
    </sql>

    <select id="selectXcxHistorySearchList" parameterType="XcxHistorySearch" resultMap="XcxHistorySearchResult">
        <include refid="selectXcxHistorySearchVo"/>
        <where>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="keyword != null  and keyword != ''"> and keyword = #{keyword}</if>
        </where>
        order by create_time
    </select>

    <select id="selectXcxHistorySearchListLimit" parameterType="XcxHistorySearch" resultMap="XcxHistorySearchResult">
        select * from xcx_history_search
        where keyword is not null and keyword != ''
        <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
        <if test="keyword != null  and keyword != ''"> and keyword = #{keyword}</if>
        order by update_time desc
        limit 20
    </select>

    <select id="selectXcxHistorySearchById" parameterType="Long" resultMap="XcxHistorySearchResult">
        <include refid="selectXcxHistorySearchVo"/>
        where id = #{id}
    </select>

    <insert id="insertXcxHistorySearch" parameterType="XcxHistorySearch">
        insert into xcx_history_search
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="phone != null">phone,</if>
            <if test="keyword != null">keyword,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="phone != null">#{phone},</if>
            <if test="keyword != null">#{keyword},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateXcxHistorySearch" parameterType="XcxHistorySearch">
        update xcx_history_search
        <trim prefix="SET" suffixOverrides=",">
            <if test="phone != null">phone = #{phone},</if>
            <if test="keyword != null">keyword = #{keyword},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXcxHistorySearchById" parameterType="Long">
        delete from xcx_history_search where id = #{id}
    </delete>

    <delete id="deleteXcxHistorySearchByIds" parameterType="String">
        delete from xcx_history_search where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
