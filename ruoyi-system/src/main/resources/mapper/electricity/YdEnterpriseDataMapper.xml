<mapper namespace="com.ruoyi.electricity.mapper.YdEnterpriseDataMapper">

    <resultMap type="YdEnterpriseData" id="YdEnterpriseDataResult">
        <result property="id"    column="id"    />
        <result property="meterNumber"    column="meter_number"    />
        <result property="meterAddress"    column="meter_address"    />
        <result property="meterProtocol"    column="meter_protocol"    />
        <result property="terminalAddress"    column="terminal_address"    />
        <result property="iotName"    column="iot_name"    />
        <result property="iotNumber"    column="iot_number"    />
        <result property="userName"    column="user_name"    />
        <result property="userNumber"    column="user_number"    />
        <result property="platformName"    column="platform_name"    />
        <result property="platformNumber"    column="platform_number"    />
        <result property="dataDate"    column="data_date"    />
        <result property="dataTime"    column="data_time"    />
        <result property="samplingMode"    column="sampling_mode"    />
        <result property="entryTime"    column="entry_time"    />
