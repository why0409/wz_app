        <result property="bActivePower"    column="b_active_power"    />
        <result property="cActivePower"    column="c_active_power"    />
        <result property="totalReactivePower"    column="total_reactive_power"    />
        <result property="aReactivePower"    column="a_reactive_power"    />
        <result property="bReactivePower"    column="b_reactive_power"    />
