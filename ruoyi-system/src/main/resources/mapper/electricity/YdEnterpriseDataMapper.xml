        delete from yd_enterprise_data where id = #{id}
    </delete>

    <delete id="deleteYdEnterpriseDataByIds" parameterType="String">
        delete from yd_enterprise_data where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
