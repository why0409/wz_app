            <if test="bReactivePower != null">#{bReactivePower},</if>
            <if test="cReactivePower != null">#{cReactivePower},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateYdEnterpriseData" parameterType="YdEnterpriseData">
        update yd_enterprise_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="meterNumber != null">meter_number = #{meterNumber},</if>
            <if test="meterAddress != null">meter_address = #{meterAddress},</if>
            <if test="meterProtocol != null">meter_protocol = #{meterProtocol},</if>
            <if test="terminalAddress != null">terminal_address = #{terminalAddress},</if>
            <if test="iotName != null">iot_name = #{iotName},</if>
            <if test="iotNumber != null">iot_number = #{iotNumber},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="userNumber != null">user_number = #{userNumber},</if>
            <if test="platformName != null">platform_name = #{platformName},</if>
            <if test="platformNumber != null">platform_number = #{platformNumber},</if>
            <if test="dataDate != null">data_date = #{dataDate},</if>
            <if test="dataTime != null">data_time = #{dataTime},</if>
            <if test="samplingMode != null">sampling_mode = #{samplingMode},</if>
            <if test="entryTime != null">entry_time = #{entryTime},</if>
