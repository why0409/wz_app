    <update id="updateLoginTimeByPhone" parameterType="com.ruoyi.system.domain.WxUserLogininfo">
        update wx_user_logininfo set login_time = #{loginTime} where phone = #{phone}
    </update>

    <update id="updateOfflineStatus" parameterType="java.util.HashSet">
        update wx_user_logininfo
        set online = 0
        where phone not in
        <foreach collection="set" open="(" separator="," close=")" item="val">
            ${val}
        </foreach>
    </update>

