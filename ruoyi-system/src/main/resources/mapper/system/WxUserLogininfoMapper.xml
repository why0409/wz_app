    <sql id="selectWxUserLogininfoVo">
        select phone, wechat_name, idcard, real_name, sex, register_time, login_time, other_phone, mar_status, h_province, h_city, h_county, h_full_addr, j_province, j_city, j_county, j_full_addr, school, xl, jn,online,photo,age,open_id from wx_user_logininfo
    </sql>

    <select id="selectWxUserLogininfoList" parameterType="WxUserLogininfo" resultMap="WxUserLogininfoResult">
        <include refid="selectWxUserLogininfoVo"/>
        <where>
            <if test="phone != null  and phone != ''"> and phone like concat('%', #{phone}, '%')</if>
            <if test="wechatName != null  and wechatName != ''"> and wechat_name like concat('%', #{wechatName}, '%')</if>
            <if test="idcard != null  and idcard != ''"> and idcard like concat('%', #{idcard}, '%')</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="sex != null  and sex != ''"> and sex = #{sex}</if>
            <if test="age != null  and age != ''"> and age = #{age}</if>
            <if test="openId != null  and openId != ''"> and open_id = #{openId}</if>
        </where>
    </select>

    <select id="selectWxUserLogininfoList3" parameterType="WxUserLogininfo" resultMap="WxUserLogininfoResult">
        <include refid="selectWxUserLogininfoVo"/>
        <where>
            <if test="phone != null  and phone != ''"> and phone like concat('%', #{phone}, '%')</if>
            <if test="wechatName != null  and wechatName != ''"> and wechat_name like concat('%', #{wechatName}, '%')</if>
            <if test="idcard != null  and idcard != ''"> and idcard like concat('%', #{idcard}, '%')</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="sex != null  and sex != ''"> and sex = #{sex}</if>
            <if test="online != null  and online != ''"> and online = #{online} </if>
            <if test="age != null  and age != ''"> and age = #{age}</if>
            <if test="openId != null  and openId != ''"> and open_id = #{openId}</if>
        </where>
        ORDER BY login_time desc
    </select>

    <select id="selectWxUserLogininfoByPhone" parameterType="String" resultMap="WxUserLogininfoResult">
