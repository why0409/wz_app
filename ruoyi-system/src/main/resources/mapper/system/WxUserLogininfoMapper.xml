    <delete id="deleteWxUserLogininfoByPhone" parameterType="String">
        delete from wx_user_logininfo where phone = #{phone}
    </delete>

    <delete id="deleteWxUserLogininfoByPhones" parameterType="String">
        delete from wx_user_logininfo where phone in
        <foreach item="phone" collection="array" open="(" separator="," close=")">
            #{phone}
