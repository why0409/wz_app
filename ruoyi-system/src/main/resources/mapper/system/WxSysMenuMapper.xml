<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.WxSysMenuMapper">

    <resultMap type="WxSysMenu" id="WxSysMenuResult">
        <result property="id"    column="id"    />
        <result property="menuName"    column="menu_name"    />
        <result property="menuIcon"    column="menu_icon"    />
        <result property="menuMark"    column="menu_mark"    />
        <result property="menuOrder"    column="menu_order"    />
        <result property="menuStatus"    column="menu_status"    />
        <result property="creatTime"    column="creat_time"    />
    </resultMap>

    <sql id="selectWxSysMenuVo">
        select id, menu_name, menu_icon, menu_mark, menu_order, menu_status, creat_time from wx_sys_menu
    </sql>

    <select id="selectWxSysMenuList" parameterType="WxSysMenu" resultMap="WxSysMenuResult">
        <include refid="selectWxSysMenuVo"/>
        <where>
            <if test="menuName != null  and menuName != ''"> and menu_name like concat('%', #{menuName}, '%')</if>
            <if test="menuMark != null  and menuMark != ''"> and menu_mark like concat('%', #{menuMark}, '%')</if>
            <if test="menuStatus != null  and menuStatus != ''"> and menu_status = #{menuStatus}</if>
        </where>
        order by CONVERT(menu_order, SIGNED)
    </select>

    <select id="selectWxSysMenuById" parameterType="Long" resultMap="WxSysMenuResult">
        <include refid="selectWxSysMenuVo"/>
        where id = #{id}
    </select>

    <select id="queryWxUserMenuByPhone" resultType="java.util.Map">
        select A.id,
               A.menu_name menuName,
               A.menu_icon menuIcon,
               A.menu_mark menuMark,
               A.menu_order menuOrder,
               A.menu_status menuStatus,
               A.creat_time createTime,
               B.phone
        from wx_sys_menu A
                 left join
                 (select distinct phone, menu_id from wx_user_menu where phone = #{phone}) B
                 on A.id = B.menu_id
        where A.menu_status = "0"
        ORDER BY (A.menu_order + 0)
    </select>

    <insert id="insertWxSysMenu" parameterType="WxSysMenu" useGeneratedKeys="true" keyProperty="id">
        insert into wx_sys_menu
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="menuName != null">menu_name,</if>
            <if test="menuIcon != null">menu_icon,</if>
            <if test="menuMark != null">menu_mark,</if>
            <if test="menuOrder != null">menu_order,</if>
            <if test="menuStatus != null">menu_status,</if>
            <if test="creatTime != null">creat_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="menuName != null">#{menuName},</if>
            <if test="menuIcon != null">#{menuIcon},</if>
            <if test="menuMark != null">#{menuMark},</if>
            <if test="menuOrder != null">#{menuOrder},</if>
            <if test="menuStatus != null">#{menuStatus},</if>
            <if test="creatTime != null">#{creatTime},</if>
         </trim>
    </insert>

    <update id="updateWxSysMenu" parameterType="WxSysMenu">
        update wx_sys_menu
        <trim prefix="SET" suffixOverrides=",">
            <if test="menuName != null">menu_name = #{menuName},</if>
            <if test="menuIcon != null">menu_icon = #{menuIcon},</if>
            <if test="menuMark != null">menu_mark = #{menuMark},</if>
            <if test="menuOrder != null">menu_order = #{menuOrder},</if>
            <if test="menuStatus != null">menu_status = #{menuStatus},</if>
            <if test="creatTime != null">creat_time = #{creatTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxSysMenuById" parameterType="Long">
        delete from wx_sys_menu where id = #{id}
    </delete>

    <delete id="deleteWxSysMenuByIds" parameterType="String">
        delete from wx_sys_menu where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
