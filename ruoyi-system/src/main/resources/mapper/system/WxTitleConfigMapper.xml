<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.WxTitleConfigMapper">

    <resultMap type="com.ruoyi.system.domain.WxTitleConfig" id="WxTitleConfigResult">
        <result property="id"    column="id"    />
        <result property="menuName"    column="menu_name"    />
        <result property="menuMark"    column="menu_mark"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="menuStatus"    column="menu_status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWxTitleConfigVo">
        select id, menu_name, menu_mark, sort_num, menu_status, create_time, update_time from wx_title_config
    </sql>

    <select id="selectWxTitleConfigList" parameterType="com.ruoyi.system.domain.WxTitleConfig" resultMap="WxTitleConfigResult">
        <include refid="selectWxTitleConfigVo"/>
        <where>
            <if test="menuName != null  and menuName != ''"> and menu_name like concat('%', #{menuName}, '%')</if>
            <if test="menuMark != null  and menuMark != ''"> and menu_mark = #{menuMark}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
            <if test="menuStatus != null  and menuStatus != ''"> and menu_status = #{menuStatus}</if>
        </where>
        order by sort_num
    </select>

    <select id="selectWxTitleConfigById" parameterType="Long" resultMap="WxTitleConfigResult">
        <include refid="selectWxTitleConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertWxTitleConfig" parameterType="com.ruoyi.system.domain.WxTitleConfig" useGeneratedKeys="true" keyProperty="id">
        insert into wx_title_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="menuName != null">menu_name,</if>
            <if test="menuMark != null">menu_mark,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="menuStatus != null">menu_status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="menuName != null">#{menuName},</if>
            <if test="menuMark != null">#{menuMark},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="menuStatus != null">#{menuStatus},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateWxTitleConfig" parameterType="com.ruoyi.system.domain.WxTitleConfig">
        update wx_title_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="menuName != null">menu_name = #{menuName},</if>
            <if test="menuMark != null">menu_mark = #{menuMark},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="menuStatus != null">menu_status = #{menuStatus},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxTitleConfigById" parameterType="Long">
        delete from wx_title_config where id = #{id}
    </delete>

    <delete id="deleteWxTitleConfigByIds" parameterType="String">
        delete from wx_title_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="checkSortNum" parameterType="integer" resultType="integer">
        select count(*) from wx_title_config where sort_num = #{sortNum}
    </select>
</mapper>