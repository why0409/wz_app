<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.onePicture.mapper.XcxMessageMapper">

    <resultMap type="XcxMessage" id="XcxMessageResult">
        <result property="id"    column="id"    />
        <result property="phone"    column="phone"    />
        <result property="message"    column="message"    />
        <result property="reply"    column="reply"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectXcxMessageVo">
        select id, phone, message, reply, create_time, update_time, remark from xcx_message
    </sql>

    <select id="selectXcxMessageList" parameterType="XcxMessage" resultMap="XcxMessageResult">
        select xm.* from xcx_message xm
        left join wx_user_logininfo wul on xm.phone = wul.phone
        <where>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="message != null  and message != ''"> and message = #{message}</if>
            <if test="reply != null  and reply != ''"> and reply = #{reply}</if>
        </where>
    </select>

    <select id="selectXcxMessageById" parameterType="Long" resultMap="XcxMessageResult">
        <include refid="selectXcxMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertXcxMessage" parameterType="XcxMessage">
        insert into xcx_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="phone != null">phone,</if>
            <if test="message != null">message,</if>
            <if test="reply != null">reply,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="phone != null">#{phone},</if>
            <if test="message != null">#{message},</if>
            <if test="reply != null">#{reply},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateXcxMessage" parameterType="XcxMessage">
        update xcx_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="phone != null">phone = #{phone},</if>
            <if test="message != null">message = #{message},</if>
            <if test="reply != null">reply = #{reply},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXcxMessageById" parameterType="Long">
        delete from xcx_message where id = #{id}
    </delete>

    <delete id="deleteXcxMessageByIds" parameterType="String">
        delete from xcx_message where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
