<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.safetyHazard.mapper.SafetyHazardUserEvaluateMapper">

    <resultMap type="SafetyHazardUserEvaluate" id="SafetyHazardUserEvaluateResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="content"    column="content"    />
        <result property="annex"    column="annex"   jdbcType="OTHER" javaType="com.alibaba.fastjson2.JSONArray" typeHandler="com.baomidou.mybatisplus.extension.handlers.FastjsonTypeHandler" />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSafetyHazardUserEvaluateVo">
        select id, user_id, content, annex, create_time, update_time from safety_hazard_user_evaluate
    </sql>

    <select id="selectSafetyHazardUserEvaluateList" parameterType="SafetyHazardUserEvaluate" resultMap="SafetyHazardUserEvaluateResult">
        <include refid="selectSafetyHazardUserEvaluateVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="annex != null  and annex != ''"> and annex = #{annex}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
