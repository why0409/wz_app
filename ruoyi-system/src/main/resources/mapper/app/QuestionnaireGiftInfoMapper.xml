<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.QuestionnaireGiftInfoMapper">

    <resultMap type="QuestionnaireGiftInfo" id="QuestionnaireGiftInfoResult">
        <result property="id"    column="id"    />
        <result property="giftNumber"    column="gift_number"    />
        <result property="phone"    column="phone"    />
        <result property="giftAddress"    column="gift_address"    />
        <result property="questionnaireId"    column="questionnaire_id"    />
        <result property="giftTime"    column="gift_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectQuestionnaireGiftInfoVo">
        select id, gift_number, phone, gift_address, questionnaire_id, gift_time, create_time, update_time from questionnaire_gift_info
    </sql>

    <select id="selectQuestionnaireGiftInfoList" parameterType="QuestionnaireGiftInfo" resultMap="QuestionnaireGiftInfoResult">
        <include refid="selectQuestionnaireGiftInfoVo"/>
        <where>
            <if test="giftNumber != null  and giftNumber != ''"> and gift_number = #{giftNumber}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="giftAddress != null  and giftAddress != ''"> and gift_address = #{giftAddress}</if>
            <if test="questionnaireId != null  and questionnaireId != ''"> and questionnaire_id = #{questionnaireId}</if>
            <if test="giftTime != null "> and gift_time = #{giftTime}</if>
        </where>
    </select>

    <select id="selectQuestionnaireGiftInfoById" parameterType="Long" resultMap="QuestionnaireGiftInfoResult">
        <include refid="selectQuestionnaireGiftInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertQuestionnaireGiftInfo" parameterType="QuestionnaireGiftInfo" useGeneratedKeys="true" keyProperty="id">
        insert into questionnaire_gift_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="giftNumber != null and giftNumber != ''">gift_number,</if>
            <if test="phone != null">phone,</if>
            <if test="giftAddress != null">gift_address,</if>
            <if test="questionnaireId != null">questionnaire_id,</if>
            <if test="giftTime != null">gift_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="giftNumber != null and giftNumber != ''">#{giftNumber},</if>
            <if test="phone != null">#{phone},</if>
            <if test="giftAddress != null">#{giftAddress},</if>
            <if test="questionnaireId != null">#{questionnaireId},</if>
            <if test="giftTime != null">#{giftTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateQuestionnaireGiftInfo" parameterType="QuestionnaireGiftInfo">
        update questionnaire_gift_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="giftNumber != null and giftNumber != ''">gift_number = #{giftNumber},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="giftAddress != null">gift_address = #{giftAddress},</if>
            <if test="questionnaireId != null">questionnaire_id = #{questionnaireId},</if>
            <if test="giftTime != null">gift_time = #{giftTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteQuestionnaireGiftInfoById" parameterType="Long">
        delete from questionnaire_gift_info where id = #{id}
    </delete>

    <delete id="deleteQuestionnaireGiftInfoByIds" parameterType="String">
        delete from questionnaire_gift_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectTodayQuestionnaireInfoByPhone" parameterType="String" resultMap="QuestionnaireGiftInfoResult">
        SELECT *
        FROM questionnaire_gift_info
        WHERE SUBSTR(gift_number,1,8) = DATE_FORMAT(CURRENT_DATE,'%Y%m%d')
        <if test="phone != null  and phone != ''">
            AND phone = #{phone}
        </if>
        ORDER BY gift_number DESC
        LIMIT 1
    </select>
</mapper>
