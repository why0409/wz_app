<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.HkxcEnterpriseTypeMapper">

    <resultMap type="HkxcEnterpriseType" id="HkxcEnterpriseTypeResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="subTitle"    column="sub_title"    />
        <result property="picture"    column="picture"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectHkxcEnterpriseTypeVo">
        select id, type, sub_title, picture, sort_num, create_time, update_time from hkxc_enterprise_type
    </sql>

    <select id="selectHkxcEnterpriseTypeList" parameterType="HkxcEnterpriseType" resultMap="HkxcEnterpriseTypeResult">
        <include refid="selectHkxcEnterpriseTypeVo"/>
        <where>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="subTitle != null  and subTitle != ''"> and sub_title = #{subTitle}</if>
            <if test="picture != null  and picture != ''"> and picture = #{picture}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
        </where>
        order by sort_num desc, create_time desc
    </select>

    <select id="selectHkxcEnterpriseTypeById" parameterType="Long" resultMap="HkxcEnterpriseTypeResult">
        <include refid="selectHkxcEnterpriseTypeVo"/>
        where id = #{id}
    </select>

    <insert id="insertHkxcEnterpriseType" parameterType="HkxcEnterpriseType">
        insert into hkxc_enterprise_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="type != null">type,</if>
            <if test="subTitle != null">sub_title,</if>
            <if test="picture != null">picture,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="type != null">#{type},</if>
            <if test="subTitle != null">#{subTitle},</if>
            <if test="picture != null">#{picture},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateHkxcEnterpriseType" parameterType="HkxcEnterpriseType">
        update hkxc_enterprise_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="subTitle != null">sub_title = #{subTitle},</if>
            <if test="picture != null">picture = #{picture},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteHkxcEnterpriseTypeById" parameterType="Long">
        delete from hkxc_enterprise_type where id = #{id}
    </delete>

    <delete id="deleteHkxcEnterpriseTypeByIds" parameterType="String">
        delete from hkxc_enterprise_type where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
