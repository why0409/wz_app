<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.HmwzCoverMapper">

    <resultMap type="HmwzCover" id="HmwzCoverResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="picture"    column="picture"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectHmwzCoverVo">
        select id, type, picture, sort_num, create_time, update_time from hmwz_cover
    </sql>

    <select id="selectHmwzCoverList" parameterType="HmwzCover" resultMap="HmwzCoverResult">
        <include refid="selectHmwzCoverVo"/>
        <where>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="picture != null  and picture != ''"> and picture = #{picture}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
        </where>
        order by sort_num desc, create_time desc
    </select>

    <select id="selectHmwzCoverById" parameterType="Long" resultMap="HmwzCoverResult">
        <include refid="selectHmwzCoverVo"/>
        where id = #{id}
    </select>

    <insert id="insertHmwzCover" parameterType="HmwzCover" useGeneratedKeys="true" keyProperty="id">
        insert into hmwz_cover
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="picture != null">picture,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="picture != null">#{picture},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateHmwzCover" parameterType="HmwzCover">
        update hmwz_cover
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="picture != null">picture = #{picture},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteHmwzCoverById" parameterType="Long">
        delete from hmwz_cover where id = #{id}
    </delete>

    <delete id="deleteHmwzCoverByIds" parameterType="String">
        delete from hmwz_cover where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
