<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace=".dao.WxClickmoduleInfoDao">

    <resultMap type=".entity.WxClickmoduleInfo" id="WxClickmoduleInfoMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="module" column="module" jdbcType="VARCHAR"/>
        <result property="time" column="time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="WxClickmoduleInfoMap">
        select
          id, phone, module, time
        from wx_clickmodule_info
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="WxClickmoduleInfoMap">
        select
          id, phone, module, time
        from wx_clickmodule_info
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="phone != null and phone != ''">
                and phone = #{phone}
            </if>
            <if test="module != null and module != ''">
                and module = #{module}
            </if>
            <if test="time != null">
                and time = #{time}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from wx_clickmodule_info
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="phone != null and phone != ''">
                and phone = #{phone}
            </if>
            <if test="module != null and module != ''">
                and module = #{module}
            </if>
            <if test="time != null">
                and time = #{time}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into wx_clickmodule_info(phone, module, time)
        values (#{phone}, #{module}, #{time})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into wx_clickmodule_info(phone, module, time)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.phone}, #{entity.module}, #{entity.time})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into wx_clickmodule_info(phone, module, time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.phone}, #{entity.module}, #{entity.time})
        </foreach>
        on duplicate key update
        phone = values(phone),
        module = values(module),
        time = values(time)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update wx_clickmodule_info
        <set>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="module != null and module != ''">
                module = #{module},
            </if>
            <if test="time != null">
                time = #{time},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from wx_clickmodule_info where id = #{id}
    </delete>

</mapper>

